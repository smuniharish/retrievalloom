flowchart LR
    classDef app fill:#ecf8f1,stroke:#2f8f5b,color:#0f2547
    classDef core fill:#eef4ff,stroke:#3567c7,color:#0f2547
    classDef provider fill:#fff7e8,stroke:#c98a12,color:#0f2547

    app["Application<br/>documents · queries · scope"]:::app

    engine["RetrievalEngine<br/>ingest · retrieve · lifecycle"]:::core
    store[("Metadata store<br/>SQLite · PostgreSQL")]:::provider

    subgraph Channels["Configured search channels"]
        direction LR
        index["Index<br/>keyword · fuzzy · BM25 · semantic"]:::provider
        graphch["Graph search"]:::provider
        structure["Structure search"]:::provider
    end

    models["Optional models<br/>embedding · reranker · NLI"]:::provider
    evidence["Ranked evidence<br/>source · version · passage"]:::app

    app --> engine
    engine --> store
    store --> Channels
    engine --> Channels
    engine -. "when configured" .-> models
    Channels --> engine
    engine --> evidence
