flowchart LR
    classDef app fill:#ecf8f1,stroke:#2f8f5b,color:#0f2547
    classDef core fill:#eef4ff,stroke:#3567c7,color:#0f2547
    classDef provider fill:#fff7e8,stroke:#c98a12,color:#0f2547

    query["Query"]:::app

    subgraph IndexChannel["index channel"]
        keyword["keyword<br/>AhoCorasickKeywordIndex<br/><i>error codes, product names</i>"]:::provider
        fuzzy["fuzzy<br/>RapidFuzzIndex<br/><i>typos, partial terms</i>"]:::provider
        sparse["sparse<br/>BM25sIndex<br/><i>questions with the right words</i>"]:::provider
        dense["dense<br/>QdrantVectorStore + your embedding model<br/><i>paraphrases</i>"]:::provider
        methodfusion["Method fusion<br/>RRF, k=60 · MethodConfig.weight"]:::core
    end

    subgraph GraphChannel["graph channel · graph extra"]
        graphch["graph<br/>LadybugGraphStore or your GraphStoreABC<br/><i>related entities</i>"]:::provider
    end

    subgraph StructureChannel["structure channel · structure extra"]
        structure["structure<br/>TreeSearchStructureEngine<br/><i>section titles</i>"]:::provider
    end

    channelfusion["Channel fusion<br/>RRF, k=60 · channel weight"]:::core
    ranked["One ranked list"]:::app

    query --> keyword & fuzzy & sparse & dense
    query --> graphch
    query --> structure
    keyword & fuzzy & sparse & dense --> methodfusion
    methodfusion --> channelfusion
    graphch --> channelfusion
    structure --> channelfusion
    channelfusion --> ranked
