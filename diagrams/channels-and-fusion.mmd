flowchart LR
    classDef app fill:#ecf8f1,stroke:#2f8f5b,color:#0f2547
    classDef core fill:#eef4ff,stroke:#3567c7,color:#0f2547
    classDef provider fill:#fff7e8,stroke:#c98a12,color:#0f2547

    query["Query"]:::app

    subgraph IndexChannel["index channel"]
        lexical["Keyword · fuzzy · BM25<br/>exact terms and variations"]:::provider
        semantic["Semantic search<br/>requires an embedding model"]:::provider
        methodfusion["Combine index methods"]:::core
    end

    subgraph GraphChannel["graph channel · graph extra"]
        graphch["Related entities and relationships"]:::provider
    end

    subgraph StructureChannel["structure channel · structure extra"]
        structure["Document structure and sections"]:::provider
    end

    channelfusion["Combine enabled channels"]:::core
    ranked["One ranked list"]:::app

    query --> lexical & semantic
    query --> graphch
    query --> structure
    lexical & semantic --> methodfusion
    methodfusion --> channelfusion
    graphch --> channelfusion
    structure --> channelfusion
    channelfusion --> ranked
