        nli["NLIABC<br/><i>you provide</i>"]:::provider
        tokenizer["TokenizerABC<br/>SimpleTokenizer"]:::provider
        dictionary["KeywordDictionaryABC<br/>MetadataKeywordDictionary"]:::provider
