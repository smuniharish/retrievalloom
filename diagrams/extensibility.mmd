        normalizer["GraphNormalizerABC<br/>IdentityGraphNormalizer"]:::provider
        embedding ~~~ reranker ~~~ nli ~~~ tokenizer ~~~ dictionary ~~~ extractor ~~~ normalizer
    end

    subgraph Indexes["Indexes · GenerationalIndexABC"]
        direction TB
        keyword["KeywordIndexABC<br/>AhoCorasickKeywordIndex"]:::provider
        fuzzy["FuzzyIndexABC<br/>RapidFuzzIndex"]:::provider
        sparse["SparseIndexABC<br/>BM25sIndex"]:::provider
        vector["VectorStoreABC<br/>QdrantVectorStore"]:::provider
        graphstore["GraphStoreABC<br/>LadybugGraphStore"]:::provider
        retriever["GraphRetrieverABC<br/>NeighborhoodGraphRetriever"]:::provider
        structure["StructureEngineABC<br/>TreeSearchStructureEngine"]:::provider
