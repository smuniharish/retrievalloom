    end

    subgraph Evidence["Evidence"]
        direction TB
        normalize["ScoreNormalizerABC<br/>MinMax · ZScore · Rank · Sigmoid"]:::provider
        fusion["FusionABC<br/>RRF · WeightedRRF · WeightedScore<br/>CombSUM · CombMNZ"]:::provider
        dedup["DeduplicatorABC<br/>IdentityAndHashDeduplicator"]:::provider
        consolidator["EvidenceConsolidatorABC<br/>HierarchicalConsolidator"]:::provider
        normalize ~~~ fusion ~~~ dedup ~~~ consolidator
    end

    subgraph Infrastructure["Infrastructure"]
        direction TB
        metadata["DocumentMetadataStoreABC<br/>SQLiteMetadataStore<br/>PostgresMetadataStore"]:::provider
        cache["CacheABC<br/>NoCache · InMemoryLRUCache"]:::provider
        access["AccessPolicyABC<br/>AllowAllAccessPolicy"]:::provider
        recorder["ProvenanceRecorderABC<br/>NoOpProvenanceRecorder<br/>AgxaiProvenanceRecorder"]:::provider
        metadata ~~~ cache ~~~ access ~~~ recorder
    end

    components["Components(...) and stores<br/>your subclasses replace the defaults"]:::app
    kits["retrievalloom.testing<br/>contract kits verify your subclass"]:::app
