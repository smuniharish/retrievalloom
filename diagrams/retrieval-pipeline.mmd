flowchart TB
    classDef app fill:#ecf8f1,stroke:#2f8f5b,color:#0f2547
    classDef core fill:#eef4ff,stroke:#3567c7,color:#0f2547
    classDef provider fill:#fff7e8,stroke:#c98a12,color:#0f2547

    request["engine.retrieve(query, scope)"]:::app

    subgraph Prepare["1 · Prepare"]
        direction LR
        authorize["Authorize request"]:::core
        plan["Apply request configuration"]:::core
        cache["Check compatible cache entry"]:::core
        authorize --> plan --> cache
    end

    search["2 · Search<br/>Configured methods run concurrently"]:::provider

    subgraph Rank["3 · Combine"]
        direction LR
        candidates["Validate and combine candidates"]:::core
        fusion["Fuse and rank results"]:::core
        candidates --> fusion
    end

    subgraph Refine["4 · Refine"]
        direction LR
        rerank["Optional reranking and NLI"]:::core
        cite["Validate and cite evidence"]:::core
        rerank --> cite
    end

    result["RetrievalResult<br/>status · evidence · warnings · timings"]:::app

    request --> Prepare
    Prepare -- "cache miss" --> search
    search --> Rank
    Rank --> Refine
    Refine --> result
