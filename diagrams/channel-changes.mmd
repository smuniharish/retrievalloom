flowchart LR
    classDef app fill:#ecf8f1,stroke:#2f8f5b,color:#0f2547
    classDef core fill:#eef4ff,stroke:#3567c7,color:#0f2547
    classDef provider fill:#fff7e8,stroke:#c98a12,color:#0f2547

    running["Engine open<br/>index channel enabled"]:::app
    reopen["Reopen with<br/>index and structure enabled"]:::app
    pending["Structure method indexes<br/>stored documents"]:::core
    background["Wait for background indexing<br/>or run backfill and wait"]:::core
    partial["Until ready, retrieval<br/>reports an index warning"]:::provider
    ready["Structure method is ready<br/>for retrieval"]:::app

    running --> reopen --> pending --> background --> ready
    pending -.-> partial
