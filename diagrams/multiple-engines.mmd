flowchart LR
    classDef app fill:#ecf8f1,stroke:#2f8f5b,color:#0f2547
    classDef core fill:#eef4ff,stroke:#3567c7,color:#0f2547
    classDef provider fill:#fff7e8,stroke:#c98a12,color:#0f2547

    subgraph HostA["Host A"]
        engineA["RetrievalEngine<br/>in-memory keyword · fuzzy · sparse"]:::core
    end

    subgraph HostB["Host B"]
        engineB["RetrievalEngine<br/>in-memory keyword · fuzzy · sparse"]:::core
    end

    postgres[("PostgreSQL metadata store<br/>documents and lifecycle state")]:::provider
    qdrant[("Qdrant server<br/>shared vector index")]:::provider
    graphdb[("Graph database server<br/>your GraphStoreABC")]:::provider

    engineA --> postgres
    engineB --> postgres
    engineA --> qdrant
    engineB --> qdrant
    engineA --> graphdb
    engineB --> graphdb
    postgres -. "shared document updates" .-> engineA
    postgres -. "shared document updates" .-> engineB
